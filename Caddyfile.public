# Front door for docker-compose.public.yml: one https origin for the pages and the API.
# DOMAIN is a real domain whose DNS points at this server: Caddy gets and renews a Let's Encrypt certificate and
# redirects http to https. DOMAIN=localhost uses Caddy's own certificate instead (for a trial run on a laptop).
# Caddy sets X-Forwarded-For/-Proto itself and ignores any the client sent, which the API's per-IP limits rely on.
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 128KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy app:3000
	}
}
