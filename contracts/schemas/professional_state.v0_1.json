{
  "$defs": {
    "Contribution": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 1000,
          "title": "Description",
          "type": "string"
        },
        "evidenceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidenceid"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "default": "project",
          "enum": [
            "project",
            "coursework",
            "professional",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "verificationStatus": {
          "default": "self_reported",
          "enum": [
            "self_reported",
            "verified"
          ],
          "title": "Verificationstatus",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "gradYear": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1950,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gradyear"
        },
        "institution": {
          "default": "",
          "maxLength": 120,
          "title": "Institution",
          "type": "string"
        },
        "major": {
          "default": "",
          "maxLength": 120,
          "title": "Major",
          "type": "string"
        }
      },
      "title": "Education",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bio": {
      "default": "",
      "maxLength": 1000,
      "title": "Bio",
      "type": "string"
    },
    "displayName": {
      "default": "",
      "maxLength": 80,
      "title": "Displayname",
      "type": "string"
    },
    "education": {
      "$ref": "#/$defs/Education"
    },
    "featuredContributions": {
      "items": {
        "$ref": "#/$defs/Contribution"
      },
      "maxItems": 10,
      "title": "Featuredcontributions",
      "type": "array"
    },
    "growthAreas": {
      "items": {
        "maxLength": 40,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Growthareas",
      "type": "array"
    },
    "handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handle"
    },
    "headline": {
      "default": "",
      "maxLength": 120,
      "title": "Headline",
      "type": "string"
    },
    "interests": {
      "items": {
        "maxLength": 40,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Interests",
      "type": "array"
    },
    "onboardingCompletedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Onboardingcompletedat"
    },
    "position": {
      "default": "",
      "maxLength": 80,
      "title": "Position",
      "type": "string"
    },
    "schemaVersion": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schemaversion",
      "type": "string"
    },
    "skills": {
      "items": {
        "maxLength": 40,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Skills",
      "type": "array"
    },
    "strengths": {
      "items": {
        "maxLength": 40,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Strengths",
      "type": "array"
    },
    "targetCareerId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Targetcareerid"
    },
    "updatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updatedat"
    },
    "userId": {
      "title": "Userid",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "userId"
  ],
  "title": "ProfessionalState",
  "type": "object"
}
