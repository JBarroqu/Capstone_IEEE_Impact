{
  "name": "wish-engine-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "api": "cd backend && .venv/bin/uvicorn wish_api.main:app --port 8000 --reload",
    "api:lan": "cd backend && .venv/bin/uvicorn wish_api.main:app --host 0.0.0.0 --port 8000",
    "api:setup": "cd backend && python3.13 -m venv .venv && .venv/bin/pip install -q -r requirements.txt",
    "build": "next build",
    "start": "next start",
    "test": "vitest run && cd backend && .venv/bin/pytest -q",
    "db:push": "cd backend && PYTHONPATH=. .venv/bin/python scripts/migrate.py",
    "seed": "cd backend && PYTHONPATH=. .venv/bin/python scripts/seed.py",
    "llm:check": "cd backend && PYTHONPATH=. .venv/bin/python scripts/llm_check.py",
    "export": "cd backend && PYTHONPATH=. .venv/bin/python scripts/export_results.py",
    "backup": "sh scripts/backup.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
