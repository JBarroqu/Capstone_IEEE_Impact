# Impact++ settings. Copy to .env (never commit it). For local development `supabase start` prints the Supabase values;
# a git-ignored .env.local with those values is loaded first (see docs/DEPLOY.md).

# Supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # production: Shared pooler, Session mode (5432)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=                    # service role / secret key (Storage, server only)
# SUPABASE_JWT_SECRET=                  # only for projects still on the legacy HS256 JWT secret
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=          # publishable (anon) key, used by the browser to sign in
VITE_GOOGLE_AUTH=off                    # "on" once a Google OAuth client is configured in Supabase

# Models (shared chain for moves, questions, classification, resume reading and the evidence rubric)
LLM_PROVIDER=auto                       # auto | gemini | ollama
GEMINI_API_KEY=
# GEMINI_MODELS=                        # optional comma list to pin models; default = discover
GROQ_API_KEY=                           # optional backup
OPENROUTER_API_KEY=                     # optional backup
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT_MS=12000
LLM_BUDGET_MS=60000

# Admin (separate from user accounts)
ADMIN_PASSWORD=change-me                # login is refused until this is 8+ characters and not change-me
SESSION_SECRET=                         # signs the admin cookie and page-close event tickets
# POLICY_ADMIN_EDIT=true                # policies can be changed on the admin page

# Public deployment (Render sets these)
# PUBLIC_MODE=true                      # API docs off, HSTS
# TRUST_PROXY=true
# PROXY_HOPS=1

# Any product policy can be overridden here by its key (backend/app/policies/defaults.py), e.g.
# VALIDATION_MODE=ai_only
# BUDDY_TIMEOUT_DAYS=3

# Tests only
# ENV=test LLM_FAKE=1                   # the fake model; refuses to load outside ENV=test
