DATABASE_URL=postgres://YOUR_MAC_USERNAME@127.0.0.1:5432/wish_engine   # local Postgres
ADMIN_PASSWORD=change-me
MOVE_PROVIDER=gemini          # gemini | ollama | static
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=8000            # per attempt; one retry on timeout or 503
LLM_CACHE=true
SHUFFLE_POSITIONS=false
