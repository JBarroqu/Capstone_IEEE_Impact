DATABASE_URL=postgres://YOUR_MAC_USERNAME@127.0.0.1:5432/wish_engine   # local Postgres
ADMIN_PASSWORD=change-me
MOVE_PROVIDER=auto            # auto = every available model, with failover | gemini | ollama
GEMINI_API_KEY=
# GEMINI_MODELS=               # optional comma list to pin models; default = discover from the API
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=                  # optional free backup (console.groq.com)
OPENROUTER_API_KEY=            # optional free backup (openrouter.ai, :free models only)
LLM_TIMEOUT_MS=12000           # per model call; a slow model is skipped for the next one
LLM_BUDGET_MS=60000            # whole request across all models before the student sees a retry
SHUFFLE_POSITIONS=false
FLOW_MOVES=1                   # 1 = pick one move then rate it (quick survey); 3 = full 3-move path
# FastAPI backend <-> Next.js frontend (all optional for local use)
# API_URL=http://127.0.0.1:8000        # where the Next server reaches the API (admin page, config)
# NEXT_PUBLIC_API_URL=                 # full API URL for the browser; default = same host as the page, port NEXT_PUBLIC_API_PORT
# NEXT_PUBLIC_API_PORT=8000
# CORS_ORIGINS=                        # comma list of page origins allowed to call the API; default = localhost + private LAN IPs
# Security (all optional locally)
# SESSION_SECRET=                      # signs the session and admin cookies; default = random key kept in the database
# RATE_LIMIT=true                      # per-IP, per-session and global request limits
# ADMIN_ALLOW_HTTP=false               # allow admin login over plain http from another machine (password in cleartext)
# TRUST_PROXY=false                    # trust X-Forwarded-*; only behind a proxy that overwrites them (on in PUBLIC_MODE)
# Public deployment (docker-compose.public.yml; see docs/DEPLOY.md)
# DOMAIN=wish.example.com              # DNS A record pointing at the server; Caddy gets the certificate
# POSTGRES_PASSWORD=                   # required there: a long random string
# PUBLIC_MODE=true                     # set by docker-compose.public.yml: API docs off, HSTS, proxy headers trusted
