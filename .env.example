DATABASE_URL=postgres://YOUR_MAC_USERNAME@127.0.0.1:5432/wish_engine   # local Postgres
ADMIN_PASSWORD=change-me
MOVE_PROVIDER=gemini          # gemini | ollama | static
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=25000            # per attempt; long on purpose
LLM_ATTEMPTS=3                 # retries on timeout / 503 / rate limit
LLM_FALLBACK=none              # none = show retry on LLM failure (default); static = silently use catalog moves
LLM_CACHE=true
SHUFFLE_POSITIONS=false
