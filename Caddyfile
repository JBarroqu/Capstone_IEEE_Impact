# Front door for docker compose. Students: http://HOST:3010. Admin: https://HOST:3443 (self-signed, accept the warning once).
# Caddy replaces any X-Forwarded-For a client sends with the real address, which the app's per-IP rate limits rely on.
{
	auto_https disable_redirects
	skip_install_trust
	# Browsers send no SNI for https://192.168.x.x, so name the certificate to use for bare-IP requests.
	default_sni {$LAN_HOST:localhost}
}

http://:3010 {
	reverse_proxy app:3000
}

https://localhost:3443, https://{$LAN_HOST:127.0.0.1}:3443 {
	tls internal
	reverse_proxy app:3000
}
